{
  "name": "cdp-cli-template",
  "version": "0.2.0",
  "description": "Template for building website-specific CDP CLI tools.",
  "type": "module",
  "private": true,
  "bin": {
    "site-cdp": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SKILL.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage test-results playwright-report",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "package:verify": "node scripts/package-verify.mjs",
    "release:preflight": "npm run quality:check && npm run build && npm run package:verify",
    "spec:validate": "node scripts/spec-validate.mjs",
    "start": "node dist/src/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contract": "node --import tsx --test test/contract/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run lint && npm run typecheck && npm run spec:validate && npm run test && npm run test:contract"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^24.29.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
